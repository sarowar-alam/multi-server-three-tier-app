# Copy to dockerCompose/.env and fill in real values — never commit the real .env
# docker compose auto-loads .env from this same folder for ${VAR} substitution

# Postgres
POSTGRES_USER=bmi_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bmidb

# Backend
PORT=3000
NODE_ENV=production
# Host "db" resolves via compose's built-in service DNS; password interpolated from POSTGRES_PASSWORD above
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
FRONTEND_URL=http://localhost
