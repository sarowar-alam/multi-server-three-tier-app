# Copy to dockerCompose/.env and fill in real values — never commit the real .env
# docker compose auto-loads .env from this same folder for ${VAR} substitution

# Postgres
POSTGRES_USER=bmi_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bmidb

# Backend
PORT=3000
NODE_ENV=production
# Host "db" resolves via compose's built-in service DNS
DATABASE_URL=postgresql://bmi_user:changeme@db:5432/bmidb
FRONTEND_URL=http://localhost
