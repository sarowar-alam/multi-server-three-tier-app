# Copy to Dockerization/.env and fill in real values — never commit the real .env

# Postgres
POSTGRES_USER=bmi_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bmidb

# Backend
PORT=3000
NODE_ENV=production
# Host "db" only resolves when containers share the bmi-network created for plain `docker run`.
# run.sh expands this via bash on source — plain `docker run --env-file` does NOT interpolate on its own.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
FRONTEND_URL=http://localhost
