# =============================================================================
# .gitattributes — Encoding & line-ending normalization
#
# Prevents UTF-8 BOM, CRLF/LF mismatches, and binary corruption.
# "text=auto eol=lf" is the standard for cross-platform projects.
# =============================================================================

# --- Default: normalize ALL text files to LF on commit ---------------------
*           text=auto eol=lf

# --- Explicitly text files (force LF, strip BOM on checkout) ---------------
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.env       text eol=lf
*.example   text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# --- Windows-specific scripts keep CRLF on Windows checkout ----------------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# --- Binary files: never diff/merge/convert --------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.tgz       binary
